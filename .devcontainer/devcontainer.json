{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  // IMPORTANT: workspaceFolder does NOT support variable substitution.
  // The setup process must patch this value per-instance (e.g., /workspaces/hub_1).
  // See setup-instructions.md Step 7.
  "workspaceFolder": "/workspaces/hub_N",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/hub_N,type=bind,consistency=cached",

  "mounts": [
    "source=${localWorkspaceFolderBasename}-venvs,target=/workspaces/.venvs,type=volume",
    "source=${localWorkspaceFolderBasename}-hf-cache,target=/home/vscode/.cache/huggingface,type=volume",
    "source=${localEnv:USERPROFILE}\\.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    "source=${localEnv:USERPROFILE}\\.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:USERPROFILE}\\Code Projects\\dot-claude,target=/home/vscode/.dot-claude,type=bind,consistency=cached"
  ],

  "runArgs": [
    "--gpus", "all",
    "--shm-size", "8g",
    "--memory", "16g",
    "--memory-swap", "16g",
    "--memory-reservation", "8g",
    "--cpuset-cpus=0-7",
    "--cpus", "8",
    "--cpu-shares", "64"
  ],

  "containerEnv": {
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics",
    "CODEX_HOME": "/home/vscode/.codex",
    "HF_HOME": "/home/vscode/.cache/huggingface",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/.venvs/${workspaceFolderBasename}/bin/python"
      }
    }
  },

  "forwardPorts": [8000],

  "initializeCommand": ".devcontainer\\initialize.cmd",
  "postCreateCommand": ".devcontainer/post-create.sh",
  "remoteUser": "vscode"
}
